{
    "name": "gaussian-splat-renderer-for-lam",
    "version": "0.0.8",
    "description": "Three.js-based 3D Gaussian splat viewer for LAM",
    "module": "build/gaussian-splat-renderer-for-lam.module.js",
    "main": "build/gaussian-splat-renderer-for-lam.umd.cjs",
    "author": "Xiaodan Ye",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build-demo": "mkdir -p ./build/demo && cp -r ./demo ./build/",
        "build-library": "npx rollup -c && mkdir -p ./build/demo/lib && cp ./build/gaussian-splat-renderer-for-lam.module.* ./build/demo/lib/",
        "build": "npm run build-library && npm run build-demo",
        "build-demo-windows": "(if not exist \".\\build\\demo\" mkdir .\\build\\demo) && xcopy /E .\\demo .\\build\\demo",
        "build-library-windows": "npx rollup -c && (if not exist \".\\build\\demo\\lib\" mkdir .\\build\\demo\\lib) && copy .\\build\\gaussian-splat-renderer-for-lam* .\\build\\demo\\lib\\",
        "build-windows": "npm run build-library-windows && npm run build-demo-windows",
        "watch": "npx npm-watch ",
        "demo": "node util/server.js -d ./build/demo",
        "fix-styling": "npx stylelint **/*.scss --fix",
        "fix-js": "npx eslint src --fix",
        "lint": "npx eslint 'src/**/*.js' || true",
        "prettify": "npx prettier --write 'src/**/*.js'"
    },
    "watch": {
        "build-library": {
            "patterns": [
                "src/**/*.js"
            ]
        },
        "build-demo": {
            "patterns": [
                "demo/**/*.*"
            ]
        }
    },
    "babel": {},
    "keywords": [
        "three",
        "threejs",
        "three.js",
        "splatting",
        "3D",
        "gaussian",
        "webgl",
        "javascript",
        "lam"
    ],
    "devDependencies": {
        "@babel/core": "7.22.0",
        "@babel/eslint-parser": "7.22.11",
        "@babel/plugin-proposal-class-properties": "7.18.6",
        "@babel/preset-env": "7.22.10",
        "@rollup/plugin-commonjs": "28.0.3",
        "@rollup/plugin-json": "6.1.0",
        "@rollup/plugin-node-resolve": "16.0.1",
        "@rollup/plugin-terser": "0.4.4",
        "@rollup/plugin-typescript": "12.1.2",
        "@rollup/pluginutils": "5.0.5",
        "@types/nprogress": "^0.2.3",
        "@types/three": "^0.173.0",
        "@types/url-parse": "^1.4.11",
        "axios": "^1.7.4",
        "babel-loader": "9.1.3",
        "eslint": "8.47.0",
        "eslint-config-google": "0.14.0",
        "file-loader": "6.2.0",
        "http-server": "14.1.1",
        "jszip": "^3.10.1",
        "npm-watch": "0.11.0",
        "nprogress": "0.2.0",
        "prettier": "3.0.2",
        "prettier-eslint": "15.0.1",
        "rollup": "3.28.1",
        "rollup-plugin-postcss": "4.0.2",
        "tslib": "2.8.1",
        "url-loader": "4.1.1",
        "url-parse": "^1.5.10"
    },
    "dependencies": {
        "three": "^0.173.0"
    },
    "files": [
        "build/gaussian-splat-renderer-for-lam.umd.cjs",
        "build/gaussian-splat-renderer-for-lam.umd.cjs.map",
        "build/gaussian-splat-renderer-for-lam.module.js",
        "build/gaussian-splat-renderer-for-lam.module.js.map"
    ]
}
